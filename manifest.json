{
  "manifest_version": 3,
  "name": "WhatsApp Group Contacts Exporter",
  "short_name": "WA Group Exporter",
  "version": "1.0.0",
  "description": "Export WhatsApp Web group members (phone, country, names, contact & business flags) to Excel or CSV. 100% local.",
  "author": "CyberAlp0",
  "homepage_url": "https://github.com/CyberAlp0/whatsapp-group-contacts-exporter",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsApp Group Contacts Exporter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/countries.js", "src/xlsx-writer.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
