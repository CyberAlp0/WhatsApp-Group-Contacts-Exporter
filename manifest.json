{
  "manifest_version": 3,
  "name": "WhatsApp Contacts & Groups Exporter",
  "short_name": "WA Exporter",
  "version": "1.1.0",
  "description": "Export WhatsApp Web contacts, chats and group members (phone, country, names, contact & business flags) to Excel or CSV. 100% local.",
  "author": "CyberAlp0",
  "homepage_url": "https://github.com/CyberAlp0/whatsapp-group-contacts-exporter",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsApp Contacts & Groups Exporter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/countries.js",
        "src/xlsx-writer.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
